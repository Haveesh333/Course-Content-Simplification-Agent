# =============================================================================
# CourseEase AI — environment configuration
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider selector
# -----------------------------------------------------------------------------
# Controls which AI backend is used.
#   granite  (default) — IBM Granite via watsonx.ai  [primary / required for submission]
#   gemini             — Google Gemini REST API       [dev / testing only]
AI_PROVIDER=gemini

# -----------------------------------------------------------------------------
# IBM watsonx.ai credentials  (required when AI_PROVIDER=granite)
# -----------------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Optional: override the default Granite model.
# Default: ibm/granite-4-h-small (Granite 4.0, multitenant, current as of Oct 2025).
# Region availability: Dallas and Frankfurt.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Optional: override the watsonx.ai region endpoint (default: us-south / Dallas).
# Use https://eu-de.ml.cloud.ibm.com for Frankfurt.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# -----------------------------------------------------------------------------
# Google Gemini credentials  (required when AI_PROVIDER=gemini)
# -----------------------------------------------------------------------------
# Obtain a Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6KOpgyvjxzbXQWSAVb17H6q-WmNSLGrlF0kqnf_K4XK7g

# Optional: override the Gemini model (default: gemini-1.5-flash).
# Other options: gemini-1.5-pro, gemini-2.0-flash, etc.
GEMINI_MODEL_ID=gemini-2.5-flash
